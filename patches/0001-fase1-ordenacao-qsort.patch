+// Sorts the given submenu by comparing the on-screen titles
+//
+// O bubblesort acima e O(n^2) em comparacoes de string: uma biblioteca de 400
+// jogos custava ~160 mil strcasecmp, e a lista e reordenada a cada troca de
+// criterio. Copiar os ponteiros para um vetor e chamar qsort reduz isso a
+// O(n log n) e, de quebra, troca o religamento no de no por uma passada linear.
+//
+// O vetor custa 8 bytes por jogo (3,2 KB para 400) e vive so durante a
+// ordenacao. Se a alocacao falhar - plausivel em 32 MB - cai no metodo antigo,
+// que ordena no lugar. Ordenar devagar e melhor que nao ordenar.
+void submenuSort(submenu_list_t **submenu)
+{
+    submenu_list_t *node;
+    submenu_ref_t *refs;
+    int count, i;
+
+    if ((submenu == NULL) || (*submenu == NULL) || ((*submenu)->next == NULL))
+        return;
+
+    for (count = 0, node = *submenu; node != NULL; node = node->next)
+        count++;
+
+    refs = (submenu_ref_t *)malloc(count * sizeof(submenu_ref_t));
+    if (refs == NULL) {
+        submenuSortBubble(submenu);
+        return;
+    }
+
+    for (i = 0, node = *submenu; node != NULL; node = node->next, i++) {
+        refs[i].node = node;
+        refs[i].idx = i;
+    }
+
+    qsort(refs, count, sizeof(submenu_ref_t), submenuSortCompare);
+
+    // Religa a lista na nova ordem. Os nos em si nao sao tocados, entao os
+    // caches de textura (cache_id/cache_uid) continuam com seus itens.
+    for (i = 0; i < count; i++) {
+        refs[i].node->prev = (i > 0) ? refs[i - 1].node : NULL;
+        refs[i].node->next = (i + 1 < count) ? refs[i + 1].node : NULL;
+    }
+
+    *submenu = refs[0].node;
+
+    free(refs);
+}
